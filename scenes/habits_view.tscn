[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/habits_view.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://scenes/today_progress.tscn" id="2_today_progress"]
[ext_resource type="PackedScene" path="res://scenes/daily_quest_card.tscn" id="3_daily_quest_card"]
[ext_resource type="Script" path="res://scripts/doodle_button.gd" id="4_doodle_button"]

[node name="HabitsView" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 112
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 120

[node name="Column" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="TodayProgress" parent="Margin/Column" instance=ExtResource("2_today_progress")]
layout_mode = 2

[node name="DailyQuestCard" parent="Margin/Column" instance=ExtResource("3_daily_quest_card")]
layout_mode = 2

[node name="Scroll" type="ScrollContainer" parent="Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="List" type="VBoxContainer" parent="Margin/Column/Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="EmptyLabel" type="Label" parent="Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
theme_type_variation = &"HeadingLabel"
text = "Henüz alışkanlık yok.
İlk alışkanlığını ekleyerek başla!"
horizontal_alignment = 1
vertical_alignment = 1

[node name="CheckInButton" type="BaseButton" parent="Margin/Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(280, 104)
layout_mode = 2
focus_mode = 0
script = ExtResource("4_doodle_button")
fill_color = Color(1, 0.75, 0.15, 1)
caption_color = Color(0.25, 0.12, 0.02, 1)
font_size = 40

[node name="AddButton" type="Button" parent="Margin/Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 72)
layout_mode = 2
focus_mode = 0
theme_type_variation = &"SkyButton"
theme_override_font_sizes/font_size = 26
text = "➕ Yeni Alışkanlık Ekle"

[node name="AddDialog" type="ConfirmationDialog" parent="."]
unique_name_in_owner = true
title = "Yeni Alışkanlık"
theme_override_constants/buttons_min_width = 140
theme_override_constants/buttons_min_height = 56
ok_button_text = "Ekle"
cancel_button_text = "İptal"

[node name="TitleEdit" type="LineEdit" parent="AddDialog"]
unique_name_in_owner = true
placeholder_text = "Alışkanlık başlığı"
max_length = 60

[node name="DeleteDialog" type="ConfirmationDialog" parent="."]
unique_name_in_owner = true
title = "Alışkanlığı Sil"
theme_override_constants/buttons_min_width = 140
theme_override_constants/buttons_min_height = 56
ok_button_text = "Sil"
cancel_button_text = "İptal"
dialog_autowrap = true

[node name="NoticeDialog" type="AcceptDialog" parent="."]
unique_name_in_owner = true
title = "Geri Alınamadı"
theme_override_constants/buttons_min_width = 140
theme_override_constants/buttons_min_height = 56
ok_button_text = "Tamam"
dialog_text = "Bu alışkanlığın ödülü harcandığı için tamamlanması geri alınamaz."
dialog_autowrap = true
